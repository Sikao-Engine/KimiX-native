// End-to-end replay: the arguments go through CallableTool2.call, the
// tool works on a real file, and the recorded expectations are the
// reference's own status/output/message/brief plus the on-disk result.
// The file after a successful call must hold exactly
//     (append ? initial : "") + write_logical      (UTF-8, LF verbatim)
// and `initial` itself when `wrote` is 0. `python_bytes` is what CPython
// actually left on disk: a text-mode write turns every LF into CRLF on
// Windows -- the one documented platform deviation, asserted to be the
// only difference. `initial`/`write_logical`/`python_bytes`/`output` are
// arbitrary bytes, so their lengths are recorded too (an embedded NUL
// would otherwise truncate a const char* comparison).
struct plan_tool_golden {
    const char *name;
    const char *tool;
    const char *params_json;
    const char *rel_path; // "" == no plan_writing_path configured
    int kind; // see KINDS
    const char *initial;
    long long initial_len;
    int exists_after;
    int wrote;
    int append;
    const char *write_logical;
    long long write_logical_len;
    const char *python_bytes;
    long long python_bytes_len;
    int is_error;
