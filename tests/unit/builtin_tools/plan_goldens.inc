// `_enable_plan` gate: False makes the reference constructor raise
// SkipThisTool, so the tool is never offered to the model. The C++
// mirror is Session::plan_enabled == false -> the invocation answers
// tool_status::unsupported instead of running.
struct plan_gate_golden {
    const char *tool;
    int python_skips;
};

