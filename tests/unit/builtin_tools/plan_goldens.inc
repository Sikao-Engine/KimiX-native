// OS-level failures. CPython's message is the raw OSError text
// ("[Errno 13] Permission denied: '<path>'" on Windows), which the port
// cannot reproduce byte-exactly; the golden pins the Python-independent
// parts plus the prefix the reference's own wrapper produces ("" for
// WritePlan, whose `except` block reports str(exc) verbatim).
struct plan_os_error_golden {
    const char *name;
    const char *tool;
    const char *params_json;
    const char *rel_path;
    int kind;
    int is_error;
    const char *message_prefix;
    const char *output;
    const char *brief;
};

