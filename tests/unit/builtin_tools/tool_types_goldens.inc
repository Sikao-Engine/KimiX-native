// Documented divergence: an integer outside [INT64_MIN, UINT64_MAX] is
// read by yyjson as a DOUBLE (its documented policy), so the native value
// is a real where CPython has an exact int.  Every vector here must parse
// natively, must render with at least one f: (a real) and must NOT equal
// CPython's canonical integer value - the reader is pinned against a
// silent precision/type change in yyjson.
struct tt_json_lossy_golden {
    kimix::string_view text;
    kimix::string_view canon; // CPython json.loads + json_canon
    kimix::string_view ref;   // ascii(repr(value)), documentation
